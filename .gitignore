# .gitignore for PlatformIO projects

# PlatformIO build and cache
.pioenvs/
.pio/build/
.piolibdeps/
.piolibcache/

# Build artifacts
build/
dist/
bin/
*.elf
*.bin
*.hex
*.map
*.o
*.a

# Python virtual environments and caches
penv/
venv/
.venv/
env/
ENV/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Editor and IDE settings
.vscode/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.idea/
*.sublime-workspace
*.sublime-project

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs and caches
.cache/
*.log

# Temp files
*.tmp
*.bak
*~
*.swp

# Optional: ignore platform/tool packages installed by PlatformIO
# Remove these lines if you intentionally check these into git.
packages/
platforms/
tools/